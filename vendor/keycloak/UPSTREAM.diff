\ No newline at end of file
+  extraParams: ""
+
+## EDNEL custom: post-import realm hardening Job (plantilla templates/realm-hardening-job.yaml)
+realmHardening:
+  enabled: false
+  image: quay.io/keycloak/keycloak:26.3.2
+  imagePullPolicy: IfNotPresent
+  backoffLimit: 5
+  ttlSecondsAfterFinished: 600
+  waitRetries: 60
+  waitSleepSeconds: 5
+  keycloakUrl: ""
+  adminUser: "admin"
+  adminPassword: ""
+  realm: ""
+  # frontendUrl del realm master. Vacio (default) = Keycloak usa KC_HOSTNAME, o sea
+  # el host publico del participante. Se rellena solo con adminRealmAccess=internal,
+  # para que la consola de administracion se AUTENTIQUE contra el host interno y no
+  # contra el publico: sin esto la consola se sirve en el host interno pero pide el
+  # login al publico, y ademas no se podria cerrar /realms/master/* en internet.
+  masterFrontendUrl: ""
+  ssoIdleTimeoutSeconds: 1800
+  masterPasswordPolicy: "length(16) and passwordHistory(20) and notUsername(undefined) and notEmail(undefined) and upperCase(1) and lowerCase(1) and digits(1) and maxLength(32) and forceExpiredPasswordChange(90)"
+  nonMasterPasswordPolicy: "length(16) and passwordHistory(20) and notUsername(undefined) and notEmail(undefined) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and maxLength(32) and forceExpiredPasswordChange(90)"
+  vault:
+    addr: ""
+    role: ""
+    # Secret (clave ca.crt) con la CA del endpoint de OpenBao. Vacio = CA publica.
+    tlsSecret: ""
+    envImage: "ghcr.io/bank-vaults/vault-env:v1.22.1"
+
+# Tras el import del realm, los usuarios admin.dataprovider/tecnico.dataprovider se crean sin
+# contrasena (requiredActions UPDATE_PASSWORD + CONFIGURE_TOTP, ver realm template). Sin este
+# job nadie les manda el enlace: Keycloak NO envia el correo solo por tener requiredActions, hay
+# que invocar explicitamente execute-actions-email (usa el smtpServer ya configurado en el import).
+sendCredentialsEmail:
+  enabled: false
+  image: quay.io/keycloak/keycloak:26.3.2
+  imagePullPolicy: IfNotPresent
+  backoffLimit: 5
+  ttlSecondsAfterFinished: 600
+  waitRetries: 60
+  waitSleepSeconds: 5
+  keycloakUrl: ""
+  adminUser: "admin"
+  adminPassword: ""
+  realm: ""
+  # Cliente publico (standardFlowEnabled) por el que el usuario completa el flujo de
+  # UPDATE_PASSWORD/CONFIGURE_TOTP en el navegador.
+  clientId: "frontend-cli"
+  redirectUri: ""
+  # Usernames fijos del realm template (no el email: el realm NO tiene
+  # registrationEmailAsUsername, pese a lo que se penso en un principio).
+  # El realm del conector EXTERNO si lo tiene y solo trae un usuario: ahi la lista
+  # es el email del admin, y la fija application.yaml con keycloak.singleAdminUser.
+  usernames:
+    - admin.dataprovider
+    - tecnico.dataprovider
+  requiredActions:
+    - UPDATE_PASSWORD
+    - CONFIGURE_TOTP
+  vault:
+    addr: ""
+    role: ""
+    tlsSecret: ""
+    envImage: "ghcr.io/bank-vaults/vault-env:v1.22.1"
+# Capa 1 del aislamiento del realm master: cierra /auth/admin/* y
+# /auth/realms/master/* en el host PUBLICO del participante. Apagado por
+# defecto -> los participantes externos no se ven afectados. Lo enciende el
+# deployer con adminRealmAccess=internal.
+masterRealmPublicBlock:
+  enabled: false
+  # Host publico donde se cierra (participant-be-<ns>.<dominio>). Obligatorio
+  # si enabled=true.
+  host: ""
+  # Tiene que ganar a la ruta que sirve /auth (un Ingress -> priority 0).
+  priority: 100
+  statusCode: 404
+  paths:
+    - /auth/realms/master
+    - /auth/realms/master/*
+    - /auth/admin
+    - /auth/admin/*
+
+## @section Keycloak Operator 26.8.1
+## Mismo interruptor que el conector interno (simpl-participant-connector external/keycloak)
+## y el authority. Con enabled=false (default) el render del chart es EL MISMO que antes.
+##   enabled=true, cutover=false -> el CR Keycloak arranca EN PARALELO sobre su BD
+##     <ns>_keycloak_op, sin exponerse (el Service `keycloak` sigue en Bitnami).
+##   enabled=true, cutover=true  -> sin StatefulSet Bitnami; el Service `keycloak`
+##     (mismo nombre y puerto) apunta a los pods del CR. tier1 /auth, users-roles, el
+##     realm-hardening y el send-credentials-email no cambian.
+## El Operator genera su StatefulSet y no admite vault-env como PID 1, asi que el CR lee
+## Secrets de Kubernetes. Quien los crea (secretsSource):
+##   job: operator-secrets-job.yaml, un Job con vault-env (conector externo, sin ESO).
+##        La BD usa el Secret que crea el operador de Postgres (db.secretName).
+##   eso: operator-externalsecrets.yaml, ExternalSecrets v1 (core on-prem).
+operator:
+  enabled: false
+  cutover: false
+  name: participant-op
+  image: quay.io/keycloak/keycloak:26.8.1
+  instances: 1
+  secretsSource: job
+  adminUsername: admin
+  # Hostnames (con /auth: contrato SIMPL, el tier1 reenvia /auth/** a este Service).
+  hostname: ""
+  adminHostname: ""
+  db:
+    host: ""
+    port: 5432
+    database: ""
+    # Secret con username/password de la BD. Vacio = keycloak-db-secret (el de ESO).
+    secretName: ""
+  # secretsSource=job: el Job que vuelca OpenBao a Secrets (valores `vault:` que resuelve
+  # vault-env por el webhook).
+  secretsJob:
+    image: docker.io/alpine/k8s:1.35.2
+    serviceAccountName: keycloak-op-secrets-sa
+    adminPassword: ""        # vault:<engine>/data/<ns>-keycloak#admin
+    configFilesToken: ""     # vault:... del token de config-files; vacio = sin token
+    smtpPassword: ""         # solo con realm.smtp.mode=literal
+    backoffLimit: 12
+    vault:
+      addr: ""
+      role: ""
+      tlsSecret: ""
+      envImage: "ghcr.io/bank-vaults/vault-env:v1.22.1"
+  # secretsSource=eso: ClusterSecretStore y paths de OpenBao (KV v2).
+  secretStore: ""
+  secrets:
+    namespacePrefix: ""   # <ns>: paths <ns>-keycloak y <ns>-keycloak-op
+  configFilesTokenSecret:
+    path: ""
+    property: token
+  smtpPasswordSecret:
+    path: ""
+    property: smtp_password
+  realm:
+    exportUrl: ""          # URL completa del realm-export del participante
+    authenticatorUrl: ""   # URL del jar del SPI
+    themeUrl: ""           # URL del jar del theme
+    insecureTls: false
+    redirectUris: ""       # JSON de la lista de redirect URIs
+    smtpFromFallback: ""
+    # Si admin y tecnico comparten correo, deja un solo usuario (realm de dos usuarios).
+    # El realm del conector externo ya trae uno solo: alli va a false y no hace falta la
+    # imagen con perl.
+    mergeUsers: true
+    # none: smtpServer vacio | secret: Secret notification-smtp | literal: host/port/... +
+    # password en el Secret keycloak-op-smtp.
+    smtp:
+      mode: none
+      secretName: notification-smtp
+      host: ""
+      port: ""
+      starttls: ""
+      username: ""
+    adminUser:
+      firstName: ""
+      lastName: ""
+      email: ""
+    technicalUser:
+      firstName: ""
+      lastName: ""
+      email: ""
+  extraEnv: []
+  initImages:
+    curl: docker.io/curlimages/curl:8.18.0
+    envsubst: docker.io/library/nginx:1.27-alpine
+    perl: docker.io/bitnamilegacy/keycloak:26.3.2-debian-12-r2
+  resources: {}
+  nodeSelector: {}
